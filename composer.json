{
    "name": "sekihin/rest-api-with-slim-php",
    "description": "REST API with PHP Slim Framework 4 and MySQL",
    "version": "0.0.0.1",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Solariis",
            "email": "sekihin2008@msn.com",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-json": "*",
        "ext-pdo": "*",
        "bayfrontmedia/monolog-pdo": "^1.0",
        "fakerphp/faker": "^1.24",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.8",
        "neuron-core/neuron-ai": "^2.12",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "pimple/pimple": "^3.6",
        "selective/basepath": "^2.2",
        "slim/http-cache": "^1.2",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.13",
        "tuupola/cors-middleware": "^1.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "src/common"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-create-project-cmd": [
            "php -r \"copy('.env.example', '.env');\"",
            "php post-create-project-command.php"
        ],
        "coverage": "phpunit --coverage-text --coverage-html coverage",
        "crud": "php console api:generate:endpoints",
        "down": "docker-compose down",
        "start": "php -S localhost:8080 -t public public/index.php",
        "test": "phpunit",
        "up": "docker-compose up -d --build"
    },
    "require-dev": {
        "maurobonfietti/skel-api-slim-php-crud-generator": "^0.22.0",
        "nunomaduro/phpinsights": "^2.12",
        "symfony/console": "^7.2"
    }
}
