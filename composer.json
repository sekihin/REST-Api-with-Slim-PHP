{
    "name": "sekihin/rest-api-with-slim-php",
    "description": "REST API with PHP Slim Framework 4 and MySQL",
    "version": "0.0.0.1",
    "type": "project",
    "license": "Apache 2.0",
    "authors": [
        {
            "name": "Solariis",
            "email": "sekihin2008@msn.com",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-json": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.8",
        "phpmailer/phpmailer": "^6.9",
        "pimple/pimple": "^3.5",
        "selective/basepath": "^2.2",
        "slim/http-cache": "^1.2",
        "slim/psr7": "^1.6",
        "slim/slim": "4.*",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "classmap": [
            "src/common"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
